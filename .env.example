# Copy to .env and adjust. Every setting is optional.

# Host port for the web UI.
COLLANDER_PORT=8080

# Image version to run: latest, a release such as 1.0.0 or 1, or edge (main branch).
# COLLANDER_VERSION=latest

# Set the login password here instead of on the first-run screen.
# COLLANDER_PASSWORD=change-me

# Set to true when Collander is served over HTTPS (e.g. behind a reverse proxy).
COLLANDER_SECURE_COOKIES=false

# How many photo/link/text imports to process at the same time.
COLLANDER_QUEUE_WORKERS=2

# AI provider: none | anthropic | openai | google | ollama
# You can also choose the provider, model and keys on the Settings page.
# API keys set here are never stored in the database.
COLLANDER_AI_PROVIDER=none
COLLANDER_AI_MODEL=
COLLANDER_ANTHROPIC_API_KEY=
COLLANDER_OPENAI_API_KEY=
# For OpenAI-compatible servers (LM Studio, vLLM, OpenRouter, ...)
COLLANDER_OPENAI_BASE_URL=
COLLANDER_GOOGLE_API_KEY=
COLLANDER_OLLAMA_BASE_URL=http://host.docker.internal:11434
