# Copy to .env and adjust. Every setting is optional.

# Host port for the web UI.
COLLANDER_PORT=8080

# Where data (database and photos) is kept: the collander-data Docker volume by default,
# or a folder next to compose.yaml. The folder must be writable by UID 1000:
#   mkdir -p data && sudo chown 1000:1000 data
# COLLANDER_DATA_VOLUME=./data

# Image version to run: latest, a release such as 1.0.0 or 1, or edge (main branch).
# COLLANDER_VERSION=latest

# Set the login password here instead of on the first-run screen.
# COLLANDER_PASSWORD=change-me

# Set to true when Collander is served over HTTPS (e.g. behind a reverse proxy).
COLLANDER_SECURE_COOKIES=false

# How many photo/link/text imports to process at the same time.
COLLANDER_QUEUE_WORKERS=2

# AI provider: none | anthropic | openai | google | ollama
# You can also choose the provider, model and keys on the Settings page.
# API keys set here are never stored in the database.
COLLANDER_AI_PROVIDER=none
COLLANDER_AI_MODEL=
COLLANDER_ANTHROPIC_API_KEY=
COLLANDER_OPENAI_API_KEY=
# For OpenAI-compatible servers (LM Studio, vLLM, OpenRouter, ...)
COLLANDER_OPENAI_BASE_URL=
COLLANDER_GOOGLE_API_KEY=
COLLANDER_OLLAMA_BASE_URL=http://host.docker.internal:11434

# Icons for recipes without a photo: none | svg | a1111 | openai | google
#   svg    - the AI model above draws a simple icon (works with any provider, including Ollama)
#   a1111  - a local Stable Diffusion server with the AUTOMATIC1111 API (A1111, Forge, sd-server)
#   openai - an OpenAI image model (default gpt-image-2); needs COLLANDER_OPENAI_API_KEY
#   google - a Gemini/Imagen image model (default gemini-2.5-flash-image); needs COLLANDER_GOOGLE_API_KEY
# Also adjustable on the Settings page.
COLLANDER_IMAGE_PROVIDER=none
# COLLANDER_IMAGE_MODEL=
# For a1111: server address, and sampling settings (8 steps / CFG 1.0 suit turbo models).
# COLLANDER_IMAGE_BASE_URL=http://host.docker.internal:7860
# COLLANDER_IMAGE_STEPS=8
# COLLANDER_IMAGE_CFG_SCALE=1.0
